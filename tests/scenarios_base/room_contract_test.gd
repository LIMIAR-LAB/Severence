extends SceneTree
const Rooms = preload("res://scripts/scenarios/room_contract.gd")
var failures := 0
func check(ok: bool, label: String) -> void:
	if not ok: failures += 1; push_error(label)
func _init() -> void:
	var template := Rooms.fixture()
	check(Rooms.validate(template).is_empty(), "valid wing fixture")
	var a := Rooms.instantiate(template, "a", Vector2(20, 30))
	var b := Rooms.instantiate(template, "b", Vector2(520, 630))
	var delta := Vector2(500, 600)
	check(b.footprint[1].position - a.footprint[1].position == delta, "wing translated")
	check(b.layers[0].rect.position - a.layers[0].rect.position == delta, "art translated")
	check(b.obstacles[0].rect.position - a.obstacles[0].rect.position == delta, "collision translated")
	check(b.connectors[0].position - a.connectors[0].position == delta, "connector translated")
	check(b.spawns[0].position - a.spawns[0].position == delta, "spawn translated")
	check(Rooms.contains(a, Vector2(350, 100)), "wing used for discovery")
	check(not Rooms.clear_at(a, a.obstacles[0].rect.get_center(), 11), "painted obstacle retains collision")
	check(Rooms.visible_obstacles(a).is_empty(), "baked obstacle not drawn twice")
	var invalid := template.duplicate(true); invalid.connectors[0].position = Vector2(50, 50)
	check(not Rooms.instantiate(invalid, "bad", Vector2.ZERO).ok, "door off boundary rejected before instance")
	invalid = template.duplicate(true); invalid.spawns[0].position = invalid.obstacles[0].rect.get_center()
	check(not Rooms.validate(invalid).is_empty(), "spawn in wall rejected")
	check(not Rooms.instantiate(template, "bad", Vector2.ZERO, "rotate90").ok, "painted rotation rejected")
	var sim := Expedition.new(); sim.start_run(1941)
	var legacy := Rooms.from_legacy(sim, "cranes")
	check(Rooms.validate(legacy).is_empty(), "effective legacy room adapted")
	var inst := Rooms.instantiate(legacy, "cranes-1", sim.room_by_id("cranes").r.position)
	check(Rooms.contains(inst, Vector2(4500, 5900)), "legacy wing retained")
	print("ROOM_CONTRACT_TESTS_DONE failures=", failures)
	quit(1 if failures else 0)
