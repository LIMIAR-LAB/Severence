; Marty: Fraturas do Tempo — playable prototype
config_version=5

[application]
config/name="Marty — Fraturas do Tempo"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/size/window_width_override=1600
window/size/window_height_override=1000
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.025, 0.042, 0.067, 1)

[audio]
driver/enable_input=false
