@@ -0,0 +1,95 @@
+"""Pack unmodified PixelLab RGBA frames; keep one scale across each character.
+
+Source layout: art/source/pixellab/dock-monsters-v2/<kind>.zip
+Output: 8 rows x 5 columns (idle, four walk poses), 96px cells.
+Run after dock_walk animations complete in the four cardinal directions.
+Diagonals keep their own idle view, matching the existing guard/bomber convention.
+"""
+from io import BytesIO
+from pathlib import Path
+from zipfile import ZipFile
+import argparse
+import json
+
+from PIL import Image
+
+ROOT = Path(__file__).resolve().parents[1]
+SOURCE = ROOT / "art/source/pixellab/dock-monsters-v2"
+TARGET = ROOT / "assets/enemies"
+DIRECTIONS = ("south", "south-east", "east", "north-east", "north",
+              "north-west", "west", "south-west")
+KINDS = ("crawler", "cult", "fish", "brute")
+ANIMATED_DIRECTIONS = ("south", "east", "north", "west")
+CELL = 96
+
+
+def read_suffix(archive, suffix):
+    matches = [name for name in archive.namelist() if name.endswith(suffix)]
+    if len(matches) != 1:
+        raise ValueError(f"Expected one {suffix}, found {matches}")
+    with Image.open(BytesIO(archive.read(matches[0]))) as source:
+        image = source.convert("RGBA")
+    if not image.getbbox():
+        raise ValueError(f"Empty frame: {suffix}")
+    if image.getextrema()[3][0] != 0:
+        raise ValueError(f"Missing transparency: {suffix}")
+    return image
+
+
+def build(kind, preview=False):
+    with ZipFile(SOURCE / f"{kind}.zip") as archive:
+        rows = []
+        for direction in DIRECTIONS:
+            poses = [read_suffix(archive, f"rotations/{direction}.png")]
+            for index in range(4):
+                suffix = f"animations/dock_walk/{direction}/frame_{index:03}.png"
+                if (preview or direction not in ANIMATED_DIRECTIONS) and not any(n.endswith(suffix) for n in archive.namelist()):
+                    poses.append(poses[0].copy())
+                else:
+                    poses.append(read_suffix(archive, suffix))
+            rows.append(poses)
+
+    # A single scale avoids breathing/pumping introduced by per-pose resizing.
+    boxes = [pose.getbbox() for row in rows for pose in row]
+    ratio = min(1.0, 84 / max(b[2]-b[0] for b in boxes),
+                84 / max(b[3]-b[1] for b in boxes))
+    atlas = Image.new("RGBA", (CELL * 5, CELL * 8))
+    for y, row in enumerate(rows):
+        # Shared origin for an animation's canvas; no per-frame recentering.
+        union = (min(p.getbbox()[0] for p in row),
+                 min(p.getbbox()[1] for p in row),
+                 max(p.getbbox()[2] for p in row),
+                 max(p.getbbox()[3] for p in row))
+        for x, pose in enumerate(row):
+            # PixelLab idle and animation canvases can have different dimensions.
+            # For differing canvases, anchor idle independently, walk as a group.
+            group = row if x == 0 or pose.size == row[0].size else row[1:]
+            bounds = union if group is row else (
+                min(p.getbbox()[0] for p in group), min(p.getbbox()[1] for p in group),
+                max(p.getbbox()[2] for p in group), max(p.getbbox()[3] for p in group))
+            if x == 0 and any(p.size != pose.size for p in row[1:]):
+                bounds = pose.getbbox()
+            sprite = pose.crop(bounds)
+            sprite = sprite.resize((max(1, round(sprite.width * ratio)),
+                                    max(1, round(sprite.height * ratio))), Image.Resampling.NEAREST)
+            if sprite.width > 92 or sprite.height > 92:
+                raise ValueError(f"{kind}: animation motion exceeds cell; adjust uniform scale")
+            atlas.alpha_composite(sprite, (x * CELL + (CELL - sprite.width)//2,
+                                           y * CELL + 92 - sprite.height))
+    TARGET.mkdir(parents=True, exist_ok=True)
+    path = TARGET / f"{kind}_pixellab_v2.png"
+    atlas.save(path)
+    report = {"kind": kind, "size": list(atlas.size), "scale": ratio,
+              "near_white_pixels": sum(1 for r,g,b,a in atlas.getdata()
+                                        if a > 128 and min(r,g,b) > 215)}
+    print(json.dumps(report))
+    return atlas
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--preview", action="store_true", help="Preview idle views before animation exports are ready")
+    parser.add_argument("kinds", nargs="*", default=list(KINDS), choices=KINDS)
+    args = parser.parse_args()
+    for kind in args.kinds:
+        build(kind, preview=args.preview)
